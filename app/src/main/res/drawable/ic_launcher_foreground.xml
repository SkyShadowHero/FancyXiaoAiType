<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景：分离键盘。
  图形取自目标应用工具栏图标 res/drawable/ic_toolbar_split_keyboard.xml（28×28 视口），
  几何路径原样保留，只把描边/填充色从 white 换成近黑 —— 它原本画在深色工具栏上，
  而这里是白底。108 视口下用 scale=2 + translate=26 居中，占约 52%，
  落在自适应图标的安全区内。

  观感处理（让它「Q」一点，阴影刻意做浅）：
   1. 两层错位阴影，只有键盘本体轮廓 —— 按键都在壳内，影子落在壳内看不见，
      所以不必复制全部按键路径；
   2. 本体填一层极浅灰，让它读起来是块实心键帽底板而不是线框；
   3. 阴影用 fill + stroke 同色，轮廓才和描边后的外形完全对齐。
  阴影偏移、透明度都留在 28 视口的子坐标系里，改起来直观。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="26"
        android:translateY="26">

        <!-- 远层阴影：偏得多、更淡 -->
        <group android:translateY="1.6">
            <path
                android:pathData="M5.75,5 h16.5 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-16.5 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z"
                android:fillColor="#12000000"
                android:strokeColor="#12000000"
                android:strokeWidth="2.0" />
        </group>

        <!-- 近层阴影：偏得少、略深，两层叠出柔和过渡 -->
        <group android:translateY="0.8">
            <path
                android:pathData="M5.75,5 h16.5 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-16.5 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z"
                android:fillColor="#1C000000"
                android:strokeColor="#1C000000"
                android:strokeWidth="2.0" />
        </group>

        <!-- 键盘本体：极浅灰底板 -->
        <path
            android:pathData="M5.75,5 h16.5 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-16.5 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z"
            android:fillColor="#FFF2F2F4" />

        <!-- 键盘外壳（描边，不填充） -->
        <path
            android:pathData="M5.75,5 h16.5 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-16.5 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 Z"
            android:strokeColor="#1A1A1A"
            android:strokeWidth="2.0" />

        <!-- 按键 -->
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M6.425,8.88 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M6.425,12.63 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M10.175,8.88 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M10.175,12.63 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <!-- 左下：被分离出来的空格键左半 -->
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M6.5,17.25 h4.5 a0.75,0.75 0 0 1 0.75,0.75 v0.5 a0.75,0.75 0 0 1 -0.75,0.75 h-4.5 a0.75,0.75 0 0 1 -0.75,-0.75 v-0.5 a0.75,0.75 0 0 1 0.75,-0.75 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M16.925,8.88 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M16.925,12.63 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M20.675,8.88 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M20.675,12.63 h0.9 a0.675,0.675 0 0 1 0.675,0.675 v0.9 a0.675,0.675 0 0 1 -0.675,0.675 h-0.9 a0.675,0.675 0 0 1 -0.675,-0.675 v-0.9 a0.675,0.675 0 0 1 0.675,-0.675 Z" />
        <!-- 右下：空格键右半 -->
        <path
            android:fillColor="#1A1A1A"
            android:pathData="M17,17.25 h4.5 a0.75,0.75 0 0 1 0.75,0.75 v0.5 a0.75,0.75 0 0 1 -0.75,0.75 h-4.5 a0.75,0.75 0 0 1 -0.75,-0.75 v-0.5 a0.75,0.75 0 0 1 0.75,-0.75 Z" />
    </group>
</vector>
