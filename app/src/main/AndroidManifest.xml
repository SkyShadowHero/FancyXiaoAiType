<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 「检查更新」要访问 GitHub API 读取最新 tag -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      应用白名单选择器需要列出可启动的应用供用户勾选。
      这里用 <queries> 声明可见性，而不是申请 QUERY_ALL_PACKAGES：
      只需要「有启动入口的应用」，范围刚好够用，也不会拿到一堆无关的系统包。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TunerApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miuix">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Miuix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 不出现在桌面，但让 LSPosed 仍能找到并打开模块设置。 -->
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 桌面入口单独放在 alias 上，设置页可只禁用它而不禁用真实 Activity。 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
