<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 「检查更新」要访问 GitHub API 读取最新 tag -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      「超级材质」页需要列出可启动的应用供用户勾选。
      这里用 <queries> 声明可见性，而不是申请 QUERY_ALL_PACKAGES：
      只需要「有启动入口的应用」，范围刚好够用，也不会拿到一堆无关的系统包。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TunerApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miuix">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Miuix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          笔引擎自检页（调试用）：验证系统 xiaomi-pencilengine-pad 能否在本进程里出字。
          **不导出**：这个页面会加载 17MB 模型并反复跑 OCR，导出就等于任何一个应用都能拉起来。
          需要触发时走 root（本机有 KernelSU）：
              su -c 'am start -n io.github.skyshadowhero.fancypad/.PencilEngineSelfTest'
          root uid 在组件权限检查里是放行的，非导出组件一样起得来。
          结果同时落在 files/selftest.txt 与模块日志里，不看屏幕也能取到结论。
        -->
        <activity
            android:name=".PencilEngineSelfTest"
            android:exported="false"
            android:label="笔引擎自检"
            android:theme="@style/Theme.Miuix" />
    </application>

</manifest>
